---
import { normalizeTechTagKey } from '../utils/techTags';

const { url, title, description, image, tags = [] } = Astro.props;
const stack = tags.join(' · ');
const tagKeys = tags.map((tag: string) => normalizeTechTagKey(tag)).filter(Boolean).join(',');
---
<li class="project" data-tags={tagKeys}>
  <a class="project-link" href={url} aria-label={`View project ${title}`}>
    {image?.url ? (
      <img class="thumb" src={image.url} alt={image.alt ?? ''} />
    ) : (
      <div class="thumb" aria-hidden="true"></div>
    )}
    <div class="project-body">
      <div class="project-top">
        <h3>{title}</h3>
        {stack && <span class="stack">{stack}</span>}
      </div>
      {description && <p>{description}</p>}
    </div>
  </a>
</li>

<style>
  .project {
    list-style: none;
    margin: 0 0 16px;
  }

  .project.hidden {
    display: none;
  }

  .project-link {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 22px;
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.012);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease;
  }

  .project-link:hover,
  .project-link:focus-visible {
    border-color: var(--accent-dim);
    outline: none;
  }

  .thumb {
    width: 120px;
    height: 88px;
    border-radius: 5px;
    object-fit: cover;
    display: block;
    border: 1px solid var(--line);
    background: linear-gradient(155deg, #2b3a3f, #182225 70%);
  }

  .project-body {
    min-width: 0;
  }

  .project-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 6px;
  }

  h3 {
    font-size: 15px;
    font-weight: 600;
    color: var(--ink);
    margin: 0;
  }

  .stack {
    font-size: 11px;
    color: var(--muted);
  }

  p {
    font-size: 13px;
    line-height: 1.7;
    color: #A9A497;
    margin: 0;
    max-width: 52ch;
  }

  @media (max-width: 520px) {
    .project-link {
      grid-template-columns: 1fr;
    }

    .thumb {
      width: 100%;
      height: 120px;
    }
  }
</style>
